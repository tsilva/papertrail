{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"]
  },
  "include": ["src/**/*.svelte", "src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
