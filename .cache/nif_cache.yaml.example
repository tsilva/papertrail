# NIF Lookup Cache
# Maps Portuguese tax numbers (NIFs) to company/issuer names
#
# This cache stores NIF → issuer name mappings to avoid repeated web lookups.
# Format: 9-digit NIF (without country prefix) → company name
#
# Cache is automatically populated when:
# 1. A document with a QR code contains a tax number (issuer_nif)
# 2. The NIF is looked up by scraping https://www.nif.pt/{NIF}/ (if enabled)
# 3. The result is cached for future lookups
#
# You can manually add entries here for known companies.
# Entries here will be used before web lookups (TIER 1 cache hit).
#
# Example:
#
# nif_to_issuer:
#   "503782467": "Anthropic, PBC"
#   "510751334": "Google Cloud Portugal"
#   "500100144": "Vodafone Portugal - Comunicações Pessoais, S.A."
#
# To enable NIF lookups, configure in your profile:
#
# nif_api:
#   enabled: true  # No API key required - uses public nif.pt URLs

nif_to_issuer: {}
