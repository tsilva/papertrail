# Local LLM Proxy Configuration
# ==============================
# Use with claude-code-bridge: https://github.com/tsilva/claude-code-bridge
#
# Setup:
#   1. Copy this file to .env.bridge
#   2. Start claude-code-bridge on port 8000
#   3. Run: python main.py --env bridge <task> <path>
#
# The --env flag loads .env.bridge instead of default.

# OpenRouter-compatible API endpoint
OPENROUTER_BASE_URL=http://127.0.0.1:8000/v1
OPENROUTER_API_KEY=claude-code-bridge

# Model IDs (claude-code-bridge format)
OPENROUTER_MODEL_ID=anthropic/claude-opus-4.5

# Optional: Higher concurrency for local proxy (no rate limits)
# MAX_WORKERS=10
