# Profile Configuration Template
# To create a new profile, create a directory and copy this file:
#   mkdir -p ~/.config/papertrail/profiles/myprofile
#   cp profile.yaml.example ~/.config/papertrail/profiles/myprofile/profile.yaml

profile:
  name: "default"
  description: "Default configuration for papertrail"
  tax_number: null  # Your tax number (NIF) — used in export rules with ${profile.tax_number}

# Directory paths for document processing
paths:
  raw:
    # List of directories to scan for new documents
    # Multiple paths can be specified (e.g., Downloads, Takeout, etc.)
    - "/path/to/raw/documents"
    - "/path/to/downloads"
  processed: "/path/to/processed/documents"
  export: "/path/to/export/documents"

# OpenAI-compatible LLM configuration. The `openrouter` key is retained for
# compatibility with existing profiles; AgentBridge + Codex is the default.
openrouter:
  model_id: "codex/gpt-5.6-sol"
  api_key: "not-needed"  # AgentBridge uses the authenticated local Codex CLI
  base_url: "http://127.0.0.1:8082/api/v1"
  requests:
    classification_max_tokens: 4096
    classification_temperature: 0
    classification_retries: 2
    normalization_max_tokens: 256
    normalization_temperature: 0
    reconciliation_max_tokens: 4096
    reconciliation_temperature: 0
    api_probe_timeout_seconds: 10

# Processing defaults. Changing hashing.content_dpi changes future content hashes;
# only change it intentionally and re-check existing sidecars afterward.
processing:
  input:
    extensions: [".pdf", ".xlsx", ".png", ".jpg", ".jpeg", ".tiff", ".tif", ".bmp", ".webp"]
    image_extensions: [".png", ".jpg", ".jpeg", ".tiff", ".tif", ".bmp", ".webp"]
    skip_dirs: ["logs"]
    skip_dir_prefixes: ["_dupes"]
    skip_hidden_files: true
  bundle:
    enabled: true
    pagination_patterns:
      - 'P[aá]g\.?\s*(\d+)\s*/\s*(\d+)'
  render:
    max_pages: 2
    enhance_contrast: true
    contrast_factor: 2.0
  qr:
    enabled: true
    dpi: 300
    max_pages: 5
    include_last: true
    currency_by_country:
      PT: "EUR"
    default_currency: "EUR"
    document_type_codes:
      FT: "invoice"
      FS: "invoice"
      FR: "invoice-receipt"
      NC: "invoice-credit"
      ND: "invoice-debit"
      RC: "receipt"
      RG: "receipt"
  hashing:
    fast_chunk_size: 8192
    content_dpi: 150
    text_min_chars: 50

workflow:
  default_months: 2
  sync_workers: 1
  metadata_load_workers: 16

tools:
  preview_dpi: 150
  xlsx_preview_max_rows: 100
  llm_high_confidence_threshold: 0.8

naming:
  component_max_chars: 80
  pdf_export_max_chars: 60
  filename_warning_max_chars: 60

dependencies:
  # Optional explicit zbar paths when ctypes cannot find the shared library.
  zbar_library_paths: []

bank_statements:
  # Parsers supply complete defaults. Add only values that differ for your bank export.
  # Example: {millennium_bcp: {header_row: 10}}
  formats: {}

nif_api:
  enabled: false
  enabled_locales: ["pt-PT"]
  base_url: "https://www.nif.pt/{nif}/"
  timeout_seconds: 10
  cache_path: null
  country_prefixes: ["PT"]

classification:
  document_title_max_chars: 60
  bank_statement_locale: "pt-PT"
  legal_suffixes:
    - inc
    - incorporated
    - ltd
    - limited
    - llc
    - llp
    - plc
    - corp
    - corporation
    - company
    - co
    - sa
    - lda
    - pbc

# Gmail integration (optional)
gmail:
  enabled: true
  default_months: 2
  output_subdir: "gmail"
  output_raw_path: null
  tracking_dir: null
  tracking_subdir: "gmail_tracking"
  # Defaults to ~/.config/papertrail/credentials/ when null.
  credentials_file: null  # Defaults to ~/.config/papertrail/credentials/gmail_credentials.json
  token_file: null  # Defaults to ~/.config/papertrail/credentials/gmail_token.json
  # Or specify custom path: "/custom/path/gmail_credentials.json"
  settings:
    attachment_mime_types: ["application/pdf"]
    label_filter: null  # e.g., "Bills" to filter by label
    max_results_per_query: 500
    skip_already_downloaded: true
    scopes: ["https://www.googleapis.com/auth/gmail.readonly"]
    extension_mime_types:
      ".pdf": "application/pdf"
      ".xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ".xls": "application/vnd.ms-excel"
    generic_mime_types:
      - "application/octet-stream"
      - "application/binary"
      - "application/force-download"
      - "application/x-download"
    api_service: "gmail"
    api_version: "v1"
    api_page_size: 100
    subject_slug_max_chars: 80

# Passwords for ZIP extraction (inline - recommended)
passwords:
  passwords:
    - "password1"
    - "password2"
  # Or use external file
  # passwords_file: "../config/passwords.txt"

# Export settings
export:
  # Warn during export when a file exceeds this size (in MB). null = no warning.
  max_file_size_mb: 3
  compression:
    enabled: true
    quality: "ebook"
    min_size_mb: null
  file_mappings:
    enabled: true
    default_prefix: "DIV_"
    filename_fields: [date_issued, document_type, issuing_party, document_title]
    rules:
      # Vendor: I issued this invoice (my tax number is the issuer)
      - match:
          document_type: "invoice"
          issuer_tax_number: "${profile.tax_number}"
        prefix: "VND_"
      - match:
          document_type: "invoice-receipt"
          issuer_tax_number: "${profile.tax_number}"
        prefix: "VND_"
      # Company: I received this invoice (someone else is the issuer)
      # Documents with no QR can be separated from QR-backed invoices with has_qrcode.
      - match:
          document_type: "invoice*"
          issuing_party: "example-issuer"
          has_qrcode: false
        prefix: "EXC_"
      # Excluded investment disclosure documents
      - match:
          document_type: "investment-key-information-document"
        prefix: "EXC_"
      - match:
          document_type: "invoice"
        prefix: "CMP_"
      - match:
          document_type: "invoice-receipt"
        prefix: "CMP_"
      # Bank statements
      - match:
          document_type: "bank-*"
        prefix: "BNC_"

  # Merge rules: append attachment document pages into target document PDFs.
  # Only applies to documents matched to the same bank transaction via reconciliation.
  # Target PDF is modified in-place (attachment pages appended). Standalone attachment PDF is kept.
  merge_rules:
    - target_type: "at-irs*"       # Portuguese tax payment proof
      attach_type: "bank-note"     # Bank transfer confirmation
    - target_type: "at-ss*"        # Social security payment proof
      attach_type: "bank-note"

# Reconciliation policy. Bundled generic defaults come from
# papertrail/reconciliation_policy.yaml. Use sparse profile overrides for local policy.
reconciliation:
  # Optional YAML files, resolved relative to this profile, merged before inline settings.
  # Example: ["reconciliation_policy.yaml"]
  policy_files: []
  exclude_prefixes: ["EXC_"]
  include_builtin_rules: true
  include_builtin_line_item_extractors: true
  # Any bundled key can be overridden inline, for example:
  # amount_tolerance: 0.05
