# Profile Configuration Template
# To create a new profile, create a directory and copy this file:
#   mkdir -p ~/.config/papertrail/profiles/myprofile
#   cp profile.yaml.example ~/.config/papertrail/profiles/myprofile/profile.yaml

profile:
  name: "default"
  description: "Default configuration for papertrail"
  tax_number: "TESTOWNER"  # Your tax number (NIF) — used in export rules with ${profile.tax_number}

# Directory paths for document processing
paths:
  raw:
    # List of directories to scan for new documents
    # Multiple paths can be specified (e.g., Downloads, Takeout, etc.)
    - "/path/to/raw/documents"
    - "/path/to/downloads"
  processed: "/path/to/processed/documents"
  export: "/path/to/export/documents"

# OpenRouter API configuration
openrouter:
  model_id: "google/gemini-2.5-flash"  # or "openai/gpt-4.1"
  # Use ${VAR} syntax to reference environment variables for security
  api_key: "${OPENROUTER_API_KEY}"
  base_url: "https://openrouter.ai/api/v1"
  requests:
    classification_max_tokens: 4096
    classification_temperature: 0
    normalization_max_tokens: 256
    normalization_temperature: 0
    reconciliation_max_tokens: 4096
    reconciliation_temperature: 0
    api_probe_timeout_seconds: 10

# Processing defaults. Changing hashing.content_dpi changes future content hashes;
# only change it intentionally and re-check existing sidecars afterward.
processing:
  render:
    max_pages: 2
    enhance_contrast: true
    contrast_factor: 2.0
  qr:
    enabled: true
    dpi: 300
    max_pages: 5
    include_last: true
    currency_by_country:
      PT: "EUR"
  hashing:
    fast_chunk_size: 8192
    content_dpi: 150
    text_min_chars: 50

nif_api:
  enabled: false
  enabled_locales: ["pt-PT"]
  base_url: "https://www.nif.pt/{nif}/"
  timeout_seconds: 10
  cache_path: null

# Gmail integration (optional)
gmail:
  enabled: true
  # Defaults to ~/.config/papertrail/credentials/ when null.
  credentials_file: null  # Defaults to ~/.config/papertrail/credentials/gmail_credentials.json
  token_file: null  # Defaults to ~/.config/papertrail/credentials/gmail_token.json
  # Or specify custom path: "/custom/path/gmail_credentials.json"
  settings:
    attachment_mime_types: ["application/pdf"]
    label_filter: null  # e.g., "Bills" to filter by label
    max_results_per_query: 500
    skip_already_downloaded: true
    scopes: ["https://www.googleapis.com/auth/gmail.readonly"]
    extension_mime_types:
      ".pdf": "application/pdf"
      ".xlsx": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      ".xls": "application/vnd.ms-excel"
    generic_mime_types:
      - "application/octet-stream"
      - "application/binary"
      - "application/force-download"
      - "application/x-download"
    api_service: "gmail"
    api_version: "v1"
    api_page_size: 100
    subject_slug_max_chars: 80

# Passwords for ZIP extraction (inline - recommended)
passwords:
  passwords:
    - "password1"
    - "password2"
  # Or use external file
  # passwords_file: "../config/passwords.txt"

# Export settings
export:
  # Warn during export when a file exceeds this size (in MB). null = no warning.
  max_file_size_mb: 3
  file_mappings:
    enabled: true
    default_prefix: "DIV_"
    filename_fields: [date_issued, document_type, issuing_party, document_title]
    rules:
      # Vendor: I issued this invoice (my tax number is the issuer)
      - match:
          document_type: "invoice"
          issuer_tax_number: "${profile.tax_number}"
        prefix: "VND_"
      - match:
          document_type: "invoice-receipt"
          issuer_tax_number: "${profile.tax_number}"
        prefix: "VND_"
      # Company: I received this invoice (someone else is the issuer)
      # Documents with no QR can be separated from QR-backed invoices with has_qrcode.
      - match:
          document_type: "invoice*"
          issuing_party: "shared-toll"
          has_qrcode: false
        prefix: "EXC_"
      # Excluded investment disclosure documents
      - match:
          document_type: "investment-key-information-document"
        prefix: "EXC_"
      - match:
          document_type: "invoice"
        prefix: "CMP_"
      - match:
          document_type: "invoice-receipt"
        prefix: "CMP_"
      # Bank statements
      - match:
          document_type: "bank-*"
        prefix: "BNC_"

  # Merge rules: append attachment document pages into target document PDFs.
  # Only applies to documents matched to the same bank transaction via reconciliation.
  # Target PDF is modified in-place (attachment pages appended). Standalone attachment PDF is kept.
  merge_rules:
    - target_type: "at-irs*"       # Portuguese tax payment proof
      attach_type: "bank-note"     # Bank transfer confirmation
    - target_type: "at-ss*"        # Social security payment proof
      attach_type: "bank-note"

# Reconciliation policy. Leave rules empty to use the built-in defaults from
# papertrail/reconciliation_defaults.py, or set rules here to replace them.
reconciliation:
  exclude_prefixes: ["EXC_"]
  include_builtin_rules: true
  include_builtin_counterparty_aliases: true
  include_builtin_line_item_extractors: true
  rules: []
  amount_tolerance: 0.01
  date_window_days: 30
  bank_export_prefix: "BNC_"
  supporting_export_prefixes: ["CMP_", "DIV_"]
  supporting_doc_type_patterns:
    - "invoice"
    - "receipt"
    - "invoice-receipt"
    - "invoice-credit"
    - "invoice-debit"
    - "invoice-order"
    - "insurance-notice"
    - "receipt-reference"
    - "receipt-delivery"
  bank_generated_doc_types:
    - "bank-card-transaction"
    - "bank-note"
    - "bank-transfer"
    - "bank-statement"
    - "bank-investment"
  statement_bank_scoped_doc_types:
    - "bank-card-transaction"
    - "bank-note"
  statement_bank_issuer_aliases:
    bancobpi: "bpi"
    bpi: "bpi"
    bancocomercialportugues: "millennium-bcp"
    bcp: "millennium-bcp"
    millennium: "millennium-bcp"
    millenniumbcp: "millennium-bcp"
  bank_counterparties: ["bpi", "millennium-bcp"]
  # Add profile-specific tax numbers or issuer aliases here.
  # counterparty_aliases:
  #   "TESTOWNER": "my-company"
  counterparty_aliases: {}
  shared_period_transaction_keywords:
    shared-toll: ["SHAREDTOLL"]
  shared_period_title_terms:
    shared-toll: ["pagamentosdeservicos", "extratorecibo"]
    "$bank": ["comissoes", "manctapacote", "operacaocartoes", "impostodoselo"]
  same_month_shared_rule_names: ["vendor-sharedtoll"]
