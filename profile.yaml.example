# Profile Configuration Template
# To create a new profile, create a directory and copy this file:
#   mkdir -p ~/.config/papertrail/profiles/myprofile
#   cp profile.yaml.example ~/.config/papertrail/profiles/myprofile/profile.yaml

profile:
  name: "default"
  description: "Default configuration for papertrail"
  tax_number: "TESTOWNER"  # Your tax number (NIF) — used in export rules with ${profile.tax_number}

# Directory paths for document processing
paths:
  raw:
    # List of directories to scan for new documents
    # Multiple paths can be specified (e.g., Downloads, Takeout, etc.)
    - "/path/to/raw/documents"
    - "/path/to/downloads"
  processed: "/path/to/processed/documents"
  export: "/path/to/export/documents"

# OpenRouter API configuration
openrouter:
  model_id: "google/gemini-2.5-flash"  # or "openai/gpt-4.1"
  # Use ${VAR} syntax to reference environment variables for security
  api_key: "${OPENROUTER_API_KEY}"
  base_url: "https://openrouter.ai/api/v1"

# Gmail integration (optional)
gmail:
  enabled: true
  # Defaults to ~/.config/papertrail/credentials/ when null.
  credentials_file: null  # Defaults to ~/.config/papertrail/credentials/gmail_credentials.json
  token_file: null  # Defaults to ~/.config/papertrail/credentials/gmail_token.json
  # Or specify custom path: "/custom/path/gmail_credentials.json"
  settings:
    attachment_mime_types: ["application/pdf"]
    label_filter: null  # e.g., "Bills" to filter by label
    max_results_per_query: 500
    skip_already_downloaded: true

# Passwords for ZIP extraction (inline - recommended)
passwords:
  passwords:
    - "password1"
    - "password2"
  # Or use external file
  # passwords_file: "../config/passwords.txt"

# Export settings
export:
  # Warn during export when a file exceeds this size (in MB). null = no warning.
  max_file_size_mb: 3
  file_mappings:
    enabled: true
    default_prefix: "DIV_"
    filename_fields: [date_issued, document_type, issuing_party, document_title]
    rules:
      # Vendor: I issued this invoice (my tax number is the issuer)
      - match:
          document_type: "invoice"
          issuer_tax_number: "${profile.tax_number}"
        prefix: "VND_"
      - match:
          document_type: "invoice-receipt"
          issuer_tax_number: "${profile.tax_number}"
        prefix: "VND_"
      # Company: I received this invoice (someone else is the issuer)
      # Documents with no QR can be separated from QR-backed invoices with has_qrcode.
      - match:
          document_type: "invoice*"
          issuing_party: "shared-toll"
          has_qrcode: false
        prefix: "EXC_"
      # Excluded investment disclosure documents
      - match:
          document_type: "investment-key-information-document"
        prefix: "EXC_"
      - match:
          document_type: "invoice"
        prefix: "CMP_"
      - match:
          document_type: "invoice-receipt"
        prefix: "CMP_"
      # Bank statements
      - match:
          document_type: "bank-*"
        prefix: "BNC_"

  # Merge rules: append attachment document pages into target document PDFs.
  # Only applies to documents matched to the same bank transaction via reconciliation.
  # Target PDF is modified in-place (attachment pages appended). Standalone attachment PDF is kept.
  merge_rules:
    - target_type: "at-irs*"       # Portuguese tax payment proof
      attach_type: "bank-note"     # Bank transfer confirmation
    - target_type: "at-ss*"        # Social security payment proof
      attach_type: "bank-note"

# Reconciliation uses built-in evidence rules from the codebase. Profile
# settings only control matching exclusions.
reconciliation:
  exclude_prefixes: ["EXC_"]
